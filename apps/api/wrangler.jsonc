{
    "name": "api-smart",
    "account_id": "db91ef648c1b228cdb5fe3d089c732b1",
    "main": "src/index.ts",
    "compatibility_date": "2025-09-10",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true,
    },
    "triggers": {
        "crons": ["*/5 * * * *"],
    },
    "preview_urls": true,
    "vars": {
        "production": true,
        "AUTH_BASE_URL": "https://api-smart.smart-agent.workers.dev/",
        "FRONTEND_BASE_URL": "https://front-smart.smart-agent.workers.dev/",
        "INFLUXDB_URL": "http://189.18.9.13:8086/",
        "INFLUXDB_ORG": "Embrapa",
        "INFLUXDB_BUCKET": "weather",
        "OPENWEATHER_URL": "https://api.openweathermap.org/data/2.5",
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "SmartAgent",
                "class_name": "SmartAgent",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["SmartAgent"],
        },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "smart-db",
            "database_id": "28d28c16-af89-494c-a77d-a61083bdd9cd",
            "migrations_dir": "database",
        },
    ],
    "kv_namespaces": [
        {
            "binding": "smart_cache",
            "id": "b518c5f11b0f4992a16a45b1a4d786fc",
            "remote": true,
        },
    ],
    "ai": {
        "binding": "ai",
    },
    "ai_search": [
        {
            "binding": "SMART_RAG",
            "instance_name": "smart-rag",
        },
    ],
}
